global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  # Default receiver for everything
  receiver: slack_default
  group_by: ['alertname', 'job', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

  # Example: send criticals to a (possibly different) Slack channel
  routes:
    - matchers:
        - severity="critical"
      receiver: slack_critical
      continue: false

receivers:
  - name: slack_default
    slack_configs:
      - api_url: '{{ lookup("env","SLACK_WEBHOOK_URL") }}'
        channel: '{{ lookup("env","SLACK_CHANNEL") | default("#alerts", true) }}'
        send_resolved: true
        title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'

  - name: slack_critical
    slack_configs:
      - api_url: '{{ lookup("env","SLACK_WEBHOOK_URL") }}'
        # Falls back to SLACK_CHANNEL if SLACK_CHANNEL_CRITICAL not set
        channel: '{{ lookup("env","SLACK_CHANNEL_CRITICAL") | default(lookup("env","SLACK_CHANNEL") | default("#alerts", true), true) }}'
        send_resolved: true
        title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'

inhibit_rules:
  # If critical is firing, suppress warning of same alert/instance
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ['alertname', 'instance']
