global:
  resolve_timeout: 5m

templates:
  - /etc/alertmanager/templates/*.tmpl

route:
  receiver: slack_default
  group_by: ['alertname', 'job', 'instance']
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 12h

  routes:
    - matchers:
        - severity="critical"
      receiver: slack_critical
      continue: false

receivers:
  - name: slack_default
    slack_configs:
      - api_url: "{{ lookup('env','SLACK_WEBHOOK_URL') }}"
        {% set ch = lookup('env','SLACK_CHANNEL') | default('', true) %}
        {% if ch %}
        channel: "{{ ch if ch.startswith('#') else '#' ~ ch }}"
        {% endif %}
        send_resolved: true
        {% raw %}title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'{% endraw %}

  - name: slack_critical
    slack_configs:
      - api_url: "{{ lookup('env','SLACK_WEBHOOK_URL') }}"
        {% set ccrit = lookup('env','SLACK_CHANNEL_CRITICAL') | default('', true) %}
        {% if ccrit %}
        channel: "{{ ccrit if ccrit.startswith('#') else '#' ~ ccrit }}"
        {% elif ch %}
        channel: "{{ ch if ch.startswith('#') else '#' ~ ch }}"
        {% endif %}
        send_resolved: true
        {% raw %}title: '{{ template "slack.title" . }}'
        text: '{{ template "slack.text" . }}'{% endraw %}

inhibit_rules:
  - source_matchers: ['severity="critical"']
    target_matchers: ['severity="warning"']
    equal: ['alertname', 'instance']
